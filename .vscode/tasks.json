{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Tests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/EnterpriseApiAutomationFramework.csproj",
        "--configuration",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run All Tests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/EnterpriseApiAutomationFramework.csproj",
        "--configuration",
        "Debug",
        "--logger",
        "console;verbosity=normal"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "Build Tests",
      "problemMatcher": []
    },
    {
      "label": "Run Login Tests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/EnterpriseApiAutomationFramework.csproj",
        "--configuration",
        "Debug",
        "--filter",
        "FullyQualifiedName~APITestingFeature",
        "--logger",
        "console;verbosity=normal"
      ],
      "group": "test",
      "dependsOn": "Build Tests",
      "problemMatcher": []
    }
  ]
}
